{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "us-artifacts-atlas",
  "main": "worker.js",
  "compatibility_date": "2026-11-14",
  "workers_dev": true,
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "us-artifacts-atlas-review",
      "database_id": "c8d9b22a-df21-4333-8288-b60b6f060406",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SUBMISSION_IMAGES",
      "bucket_name": "us-artifacts-atlas-review"
    }
  ],
  "ratelimits": [
    {
      "name": "SUBMISSION_RATE_LIMITER",
      "namespace_id": "2026111401",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": ["15 4 * * *"]
  }
}
